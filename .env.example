# dev DB: existing Postgres instance on this machine (~/docker/odoo-postgres/, container "odoo-postgres")
# dedicated DB created via: docker exec odoo-postgres psql -U odoo -c "CREATE DATABASE wedding_dev;"
DATABASE_URL=postgresql://odoo:<password-from-~/docker/odoo-postgres/.env>@localhost:5432/wedding_dev

# production (Vercel): set this instead of DATABASE_URL. Vercel can't reach the mini PC's
# Postgres directly, so requests go through PostgREST behind the Cloudflare Tunnel.
# When POSTGREST_URL is set, DATABASE_URL is not used at all.
# POSTGREST_URL=https://api.natasya.bayuik.com
