---
import FloralImage from "./FloralImage.astro";
import FloatingPetals from "./FloatingPetals.astro";
import BotanicalPlate from "./BotanicalPlate.astro";

interface Props {
  guestName: string | null;
}
const { guestName } = Astro.props;
---

<section
  id="cover"
  class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-dusty-900 px-6 text-center text-cream-50"
>
  <!-- layered background wash -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-dusty-900 via-dusty-700/40 to-dusty-900"></div>
  <div class="pointer-events-none absolute top-1/2 left-1/2 h-[34rem] w-[34rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-terracotta-500/20 blur-3xl animate-glow"></div>

  <FloatingPetals />

  <!-- corner bouquets -->
  <FloralImage class="pointer-events-none absolute -top-6 -left-8 h-48 w-auto opacity-95 sm:h-64" />
  <FloralImage class="pointer-events-none absolute -top-4 -right-8 h-40 w-auto -scale-x-100 opacity-90 sm:h-56" />

  <!-- mid-height side sprigs, drifting -->
  <FloralImage class="animate-drift pointer-events-none absolute top-1/3 -left-10 h-28 w-auto rotate-45 opacity-60 sm:h-36 md:h-44" />
  <FloralImage class="animate-drift pointer-events-none absolute top-[40%] -right-10 h-28 w-auto -rotate-45 -scale-x-100 opacity-60 sm:h-36 md:h-44" style="animation-delay: 2s" />

  <!-- dense garland along the bottom -->
  <div class="pointer-events-none absolute right-0 -bottom-2 left-0 flex items-end justify-center gap-0.5 opacity-95">
    <FloralImage class="h-16 w-auto translate-y-6 rotate-6 sm:h-24" />
    <FloralImage class="h-24 w-auto translate-y-3 rotate-12 sm:h-32" />
    <FloralImage class="h-32 w-auto sm:h-44" />
    <FloralImage class="h-20 w-auto translate-y-5 -rotate-12 -scale-x-100 sm:h-28" />
    <FloralImage class="h-36 w-auto -scale-x-100 sm:h-48" />
    <FloralImage class="h-20 w-auto translate-y-4 rotate-12 sm:h-28" />
    <FloralImage class="h-28 w-auto translate-y-1 -scale-x-100 sm:h-40" />
    <FloralImage class="h-16 w-auto translate-y-6 rotate-6 sm:h-24" />
  </div>

  <!-- content -->
  <div class="relative z-10 flex flex-col items-center">
    <p class="font-display text-sm tracking-[0.35em] uppercase text-dusty-100 sm:text-base">
      The Wedding of
    </p>

    <div class="relative mt-6">
      <BotanicalPlate
        plate="white"
        shape="arch"
        class="h-56 w-40 sm:h-72 sm:w-52"
      />
      <FloralImage class="pointer-events-none absolute -bottom-4 -left-10 h-20 w-auto sm:h-24" />
      <FloralImage class="pointer-events-none absolute -right-10 -bottom-4 h-20 w-auto -scale-x-100 sm:h-24" />
    </div>

    <h1 class="font-display mt-8 text-5xl leading-tight sm:text-6xl">Bayu &amp; Natasya</h1>

    <div class="mt-4 flex items-center gap-3">
      <span class="h-px w-10 bg-terracotta-300/60"></span>
      <p class="text-sm tracking-[0.2em] text-terracotta-300">08 . 11 . 2026</p>
      <span class="h-px w-10 bg-terracotta-300/60"></span>
    </div>

    {guestName && (
      <div class="mt-8 rounded-2xl border border-dusty-700/60 bg-dusty-900/50 px-6 py-4 backdrop-blur-sm">
        <p class="text-xs tracking-wide text-dusty-100">Kepada Yth. Bapak/Ibu/Saudara/i</p>
        <p class="font-display mt-1 text-2xl text-cream-50">{guestName}</p>
      </div>
    )}

    <button
      id="open-invitation"
      class="mt-10 rounded-full border border-terracotta-300 bg-terracotta-500/10 px-8 py-3 text-sm tracking-widest uppercase text-terracotta-300 backdrop-blur-sm transition hover:bg-terracotta-300 hover:text-dusty-900"
    >
      Buka Undangan
    </button>
  </div>
</section>

<script>
  const btn = document.getElementById("open-invitation");
  const cover = document.getElementById("cover");
  btn?.addEventListener("click", () => {
    cover?.classList.add("hidden");
    document.getElementById("main-content")?.classList.remove("hidden");
    document.dispatchEvent(new CustomEvent("invitation:open"));
    document.body.style.overflow = "auto";
  });
</script>
