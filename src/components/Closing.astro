---
import { t } from "../lib/i18n";
import FloralImage from "./FloralImage.astro";
import BotanicalPlate from "./BotanicalPlate.astro";
import FloatingPetals from "./FloatingPetals.astro";
import WeddingHashtag from "./WeddingHashtag.astro";
---

<section class="relative overflow-hidden bg-dusty-900 px-6 py-16 text-center text-cream-50">
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-dusty-900 via-dusty-700/30 to-dusty-900"></div>
  <FloatingPetals />

  <FloralImage class="pointer-events-none absolute -top-4 -left-6 h-40 w-auto opacity-90 sm:h-52" />
  <FloralImage class="pointer-events-none absolute -right-6 -bottom-4 h-40 w-auto -scale-x-100 opacity-90 sm:h-52" />

  <div class="relative z-10 flex flex-col items-center">
    <div class="relative">
      <BotanicalPlate plate="wild" shape="arch" class="h-48 w-36 sm:h-56 sm:w-40" data-reveal="zoom" />
      <FloralImage class="pointer-events-none absolute -bottom-3 -left-8 h-20 w-auto sm:h-24" />
      <FloralImage class="pointer-events-none absolute -right-8 -bottom-3 h-20 w-auto -scale-x-100 sm:h-24" />
    </div>

    <h2 class="font-display mt-10 text-5xl sm:text-6xl" data-reveal data-i18n="closing.thanks">{t("closing.thanks")}</h2>

    <p class="mx-auto mt-5 max-w-md text-sm text-dusty-100" data-reveal>
      <span data-i18n="closing.appreciate">{t("closing.appreciate")}</span>
      <br />
      <span data-i18n="closing.seeyou">{t("closing.seeyou")}</span>
    </p>

    <WeddingHashtag class="mt-6 text-base" data-reveal />

    <div class="mt-10 flex items-center justify-center gap-3" data-reveal>
      <span class="h-px w-10 bg-terracotta-300/50"></span>
      <span class="h-1.5 w-1.5 rotate-45 bg-terracotta-300"></span>
      <span class="h-px w-10 bg-terracotta-300/50"></span>
    </div>

    <h3 class="font-display mt-8 text-2xl" data-reveal data-i18n="closing.salam">{t("closing.salam")}</h3>
    <p class="font-arabic mt-4 text-2xl" data-reveal data-i18n="closing.hamdalah">{t("closing.hamdalah")}</p>

    <div class="mt-10 flex items-end justify-center gap-1 opacity-90" aria-hidden="true">
      <FloralImage class="h-12 w-auto translate-y-2 rotate-6 sm:h-16" />
      <FloralImage class="h-16 w-auto sm:h-20" />
      <FloralImage class="h-12 w-auto translate-y-2 -scale-x-100 sm:h-16" />
    </div>
  </div>
</section>
