---
import { t } from "../lib/i18n";
import FloralImage from "./FloralImage.astro";
import BotanicalPlate from "./BotanicalPlate.astro";
import FloralDivider from "./FloralDivider.astro";
---

<section class="bg-botanical relative overflow-hidden bg-cream-100 px-6 py-16 text-center">
  <FloralImage class="pointer-events-none absolute -top-4 -left-6 h-40 w-auto opacity-90 sm:h-52" />
  <FloralImage class="pointer-events-none absolute -right-6 -bottom-4 h-40 w-auto -scale-x-100 opacity-90 sm:h-52" />
  <FloralImage class="animate-drift pointer-events-none absolute top-1/3 -right-8 hidden h-28 w-auto -rotate-90 opacity-50 sm:block" data-parallax="0.18" />
  <FloralImage class="animate-drift pointer-events-none absolute bottom-1/4 -left-8 hidden h-28 w-auto rotate-90 -scale-x-100 opacity-50 sm:block" data-parallax="0.22" />

  <p class="font-arabic text-2xl text-dusty-900" data-reveal data-i18n="couple.bismillah">{t("couple.bismillah")}</p>
  <h2 class="font-display mt-4 text-2xl text-dusty-900" data-reveal data-i18n="couple.salam">
    {t("couple.salam")}
  </h2>
  <p class="mx-auto mt-4 max-w-md text-sm text-dusty-700" data-reveal data-i18n="couple.intro">
    {t("couple.intro")}
  </p>

  <FloralDivider class="mt-10" />

  <!-- Quran verses flanked by botanical plates -->
  <div class="mx-auto mt-10 flex max-w-4xl items-center justify-center gap-6">
    <BotanicalPlate
      plate="wild"
      shape="arch"
      class="hidden h-72 w-44 shrink-0 lg:block"
      data-reveal="left"
    />

    <div class="flex max-w-md flex-1 flex-col gap-4">
      <div class="rounded-xl border border-terracotta-300/30 bg-cream-50/80 p-4 text-sm text-dusty-700 shadow-sm" data-reveal>
        <p data-i18n="couple.verse1">{t("couple.verse1")}</p>
        <a href="https://quran.com/id/51/49" target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-terracotta-500">
          <span data-i18n="couple.verse1.ref">{t("couple.verse1.ref")}</span>
        </a>
      </div>
      <div class="rounded-xl border border-terracotta-300/30 bg-cream-50/80 p-4 text-sm text-dusty-700 shadow-sm" data-reveal style="transition-delay: 120ms">
        <p data-i18n="couple.verse2">{t("couple.verse2")}</p>
        <a href="https://quran.com/id/53/45" target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-terracotta-500">
          <span data-i18n="couple.verse2.ref">{t("couple.verse2.ref")}</span>
        </a>
      </div>
    </div>

    <BotanicalPlate
      plate="bloom"
      shape="arch"
      class="hidden h-72 w-44 shrink-0 lg:block"
      data-reveal="right"
    />
  </div>

  <!-- couple portraits in arch frames -->
  <div class="mx-auto mt-20 flex max-w-3xl flex-col items-center gap-12 sm:flex-row sm:justify-center sm:gap-8">
    <div class="relative flex flex-col items-center" data-reveal="left">
      <div class="relative">
        <div class="arch h-56 w-44 bg-dusty-100 ring-1 ring-terracotta-300/40 shadow-lg sm:h-64 sm:w-52"></div>
        <FloralImage class="pointer-events-none absolute -bottom-3 -left-8 h-20 w-auto sm:h-24" />
        <FloralImage class="pointer-events-none absolute -top-4 -right-6 h-16 w-auto -scale-x-100 opacity-90 sm:h-20" />
      </div>
      <h2 class="font-display mt-6 text-3xl text-dusty-900">Wahyu</h2>
      <p class="mt-1 text-sm text-dusty-700" data-i18n="couple.groom.parents">{t("couple.groom.parents")}</p>
    </div>

    <div class="flex flex-col items-center gap-2" data-reveal="zoom">
      <FloralImage class="h-12 w-auto opacity-90" />
      <p class="font-display text-5xl text-terracotta-500">&amp;</p>
      <FloralImage class="h-12 w-auto rotate-180 opacity-90" />
    </div>

    <div class="relative flex flex-col items-center" data-reveal="right">
      <div class="relative">
        <div class="arch h-56 w-44 bg-dusty-100 ring-1 ring-terracotta-300/40 shadow-lg sm:h-64 sm:w-52"></div>
        <FloralImage class="pointer-events-none absolute -right-8 -bottom-3 h-20 w-auto -scale-x-100 sm:h-24" />
        <FloralImage class="pointer-events-none absolute -top-4 -left-6 h-16 w-auto opacity-90 sm:h-20" />
      </div>
      <h2 class="font-display mt-6 text-3xl text-dusty-900">Calon Wanita</h2>
      <p class="mt-1 text-sm text-dusty-700" data-i18n="couple.bride.parents">{t("couple.bride.parents")}</p>
    </div>
  </div>
</section>
