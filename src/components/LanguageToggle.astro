---
import { LANGS, DEFAULT_LANG } from "../lib/i18n";
---

<div
  class="fixed top-4 right-4 z-50 flex overflow-hidden rounded-full border border-terracotta-300/60 bg-dusty-900/70 text-xs backdrop-blur-sm"
  role="group"
  aria-label="Pilih bahasa / Choose language"
>
  {LANGS.map((l) => (
    <button
      type="button"
      data-lang-btn={l}
      class="px-3 py-1.5 uppercase tracking-widest text-dusty-100 transition aria-pressed:bg-terracotta-300 aria-pressed:text-dusty-900"
      aria-pressed={l === DEFAULT_LANG}
    >
      {l}
    </button>
  ))}
</div>
