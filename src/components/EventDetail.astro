---
import { t } from "../lib/i18n";
import FloralImage from "./FloralImage.astro";
import BotanicalPlate from "./BotanicalPlate.astro";
import FloatingPetals from "./FloatingPetals.astro";

const events = [
  { key: "akad", mapsQuery: "Kediaman Mempelai Wanita", plate: "white" as const },
  { key: "resepsi", mapsQuery: "Gedung Resepsi", plate: "cluster" as const },
];
---

<section class="relative overflow-hidden bg-dusty-900 px-6 py-16 text-center text-cream-50">
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-dusty-900 via-dusty-700/30 to-dusty-900"></div>
  <FloatingPetals />

  <FloralImage class="pointer-events-none absolute -top-4 -right-6 h-40 w-auto -scale-x-100 opacity-90 sm:h-52" />
  <FloralImage class="pointer-events-none absolute -bottom-4 -left-6 h-40 w-auto rotate-180 opacity-90 sm:h-52" />
  <FloralImage class="animate-drift pointer-events-none absolute top-1/2 -left-10 hidden h-32 w-auto rotate-45 opacity-50 md:block" data-parallax="0.2" />
  <FloralImage class="animate-drift pointer-events-none absolute top-1/3 -right-10 hidden h-32 w-auto -rotate-45 -scale-x-100 opacity-50 md:block" data-parallax="0.25" />

  <div class="relative z-10">
    <h2 class="font-display text-4xl" data-reveal data-i18n="event.title">{t("event.title")}</h2>
    <div class="mx-auto mt-4 flex items-center justify-center gap-2" data-reveal>
      <span class="h-px w-14 bg-terracotta-300/50"></span>
      <FloralImage class="h-10 w-auto opacity-90" />
      <span class="h-px w-14 bg-terracotta-300/50"></span>
    </div>
    <p class="mx-auto mt-4 max-w-md text-sm text-dusty-100" data-reveal data-i18n="event.intro">
      {t("event.intro")}
    </p>

    <div class="mx-auto mt-12 grid max-w-3xl gap-10 sm:grid-cols-2">
      {events.map((e, i) => (
        <div class="flex flex-col items-center" data-reveal={i === 0 ? "left" : "right"}>
          <div class="relative">
            <BotanicalPlate plate={e.plate} shape="arch" class="h-48 w-36 sm:h-56 sm:w-40" />
            <FloralImage class="pointer-events-none absolute -bottom-3 -left-7 h-16 w-auto sm:h-20" />
            <FloralImage class="pointer-events-none absolute -right-7 -bottom-3 h-16 w-auto -scale-x-100 sm:h-20" />
          </div>

          <div class="mt-6 w-full rounded-2xl border border-dusty-700/70 bg-dusty-900/60 p-6 backdrop-blur-sm">
            <h3 class="font-display text-2xl text-terracotta-300" data-i18n={`event.${e.key}`}>{t(`event.${e.key}`)}</h3>
            <p class="mt-3 text-sm" data-i18n="event.date">{t("event.date")}</p>
            <p class="text-sm" data-i18n={`event.${e.key}.time`}>{t(`event.${e.key}.time`)}</p>
            <p class="mt-3 text-sm text-dusty-100" data-i18n={`event.${e.key}.place`}>{t(`event.${e.key}.place`)}</p>
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(e.mapsQuery)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-block rounded-full border border-terracotta-300 px-5 py-2 text-xs tracking-widest uppercase text-terracotta-300 transition hover:bg-terracotta-300 hover:text-dusty-900"
            >
              <span data-i18n="event.map">{t("event.map")}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    {/* Dress code disembunyikan: "Batik, dominasi hitam" itu bawaan undangan lama,
        belum tentu dipakai lagi. Untuk memunculkan, hapus komentar ini lalu ubah
        event.dresscode.* di src/lib/i18n.ts (dua bahasa).
    <div class="mx-auto mt-16 max-w-md rounded-2xl border border-dusty-700/70 bg-dusty-900/50 px-6 py-8 backdrop-blur-sm" data-reveal="zoom">
      <p class="text-sm text-dusty-100" data-i18n="event.dresscode.intro">
        {t("event.dresscode.intro")}
      </p>
      <div class="mt-3 flex items-center justify-center gap-3">
        <FloralImage class="h-10 w-auto opacity-90" />
        <p class="font-display text-3xl text-terracotta-300" data-i18n="event.dresscode.name">{t("event.dresscode.name")}</p>
        <FloralImage class="h-10 w-auto -scale-x-100 opacity-90" />
      </div>
      <p class="mt-1 text-sm text-dusty-100" data-i18n="event.dresscode.note">{t("event.dresscode.note")}</p>
    </div>
    */}
  </div>
</section>
