---
import { t } from "../lib/i18n";
import FloralImage from "./FloralImage.astro";
const links = {
  youtube: "https://www.youtube.com/watch?v=tAIiXRZNh9E&t=2399s", // full watch URL, embed derived below. Kosongkan kalau belum siap: tamu akan lihat pesan netral, bukan instruksi kode.
  instagram: "https://www.instagram.com/tasyanwr/",
  tiktok: "https://www.tiktok.com/@byu.ik",
};

/**
 * Builds a proper /embed/ URL. A plain string replace is not enough: a watch URL
 * carrying extra params (`&t=2399s`) would leave them dangling after the video id
 * with no `?`, which YouTube rejects. Handles youtu.be short links too.
 */
function toYoutubeEmbed(watchUrl: string): string | null {
  if (!watchUrl) return null;

  let id: string | null = null;
  let startSeconds: number | null = null;

  try {
    const url = new URL(watchUrl);
    id = url.hostname.includes("youtu.be")
      ? url.pathname.slice(1)
      : url.searchParams.get("v");

    const t = url.searchParams.get("t") ?? url.searchParams.get("start");
    if (t) {
      // accepts "2399", "2399s", and "1h2m3s"
      const hms = t.match(/^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s?)?$/);
      if (hms) {
        const [, h, m, s] = hms;
        startSeconds =
          Number(h ?? 0) * 3600 + Number(m ?? 0) * 60 + Number(s ?? 0);
      }
    }
  } catch {
    return null;
  }

  if (!id) return null;

  const embed = new URL(`https://www.youtube.com/embed/${id}`);
  if (startSeconds) embed.searchParams.set("start", String(startSeconds));
  return embed.toString();
}

const youtubeEmbed = toYoutubeEmbed(links.youtube);
---

<section class="bg-botanical relative overflow-hidden bg-cream-100 px-6 py-16 text-center">
  <FloralImage class="pointer-events-none absolute -top-4 -right-6 h-36 w-auto -scale-x-100 opacity-85 sm:h-48" />
  <FloralImage class="pointer-events-none absolute -bottom-4 -left-6 h-36 w-auto rotate-180 opacity-85 sm:h-48" />

  <h2 class="font-display text-4xl text-dusty-900" data-reveal data-i18n="live.title">{t("live.title")}</h2>
  <div class="mx-auto mt-4 flex items-center justify-center gap-2" data-reveal>
    <span class="h-px w-14 bg-terracotta-500/40"></span>
    <FloralImage class="h-10 w-auto opacity-90" />
    <span class="h-px w-14 bg-terracotta-500/40"></span>
  </div>
  <p class="mx-auto mt-3 max-w-md text-sm text-dusty-700" data-reveal data-i18n="live.intro">
    {t("live.intro")}
  </p>

  <div class="mx-auto mt-10 max-w-2xl" data-reveal>
    {youtubeEmbed ? (
      <div class="aspect-video overflow-hidden rounded-xl">
        <iframe
          class="h-full w-full"
          src={youtubeEmbed}
          title="Live Streaming Akad & Resepsi"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    ) : (
      <div class="rounded-xl border border-dashed border-dusty-300 p-10 text-sm text-dusty-700">
        <span data-i18n="live.empty">{t("live.empty")}</span>
      </div>
    )}

    <p class="mt-6 text-xs text-dusty-700" data-i18n="live.note">
      {t("live.note")}
    </p>
    <div class="mt-4 flex flex-wrap justify-center gap-3">
      <a
        href={links.instagram || "#"}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-terracotta-500 px-5 py-2 text-xs tracking-widest text-cream-50 uppercase hover:bg-terracotta-700"
      >
        <span data-i18n="live.ig">{t("live.ig")}</span>
      </a>
      <a
        href={links.tiktok || "#"}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-dusty-700 px-5 py-2 text-xs tracking-widest text-cream-50 uppercase hover:bg-dusty-900"
      >
        <span data-i18n="live.tiktok">{t("live.tiktok")}</span>
      </a>
    </div>
  </div>
</section>
