---
import { t } from "../lib/i18n";
import FloralImage from "./FloralImage.astro";
import BotanicalPlate from "./BotanicalPlate.astro";

const moments = [
  { key: "story.1", plate: "cluster" as const },
  { key: "story.2", plate: "wild" as const },
  { key: "story.3", plate: "bloom" as const },
];
---

<section class="bg-botanical relative overflow-hidden bg-dusty-100 px-6 py-16">
  <FloralImage class="pointer-events-none absolute -top-4 -right-6 h-40 w-auto -scale-x-100 opacity-85 sm:h-52" />
  <FloralImage class="pointer-events-none absolute -bottom-4 -left-6 h-40 w-auto rotate-180 opacity-85 sm:h-52" />

  <h2 class="font-display text-center text-4xl text-dusty-900" data-reveal data-i18n="story.title">{t("story.title")}</h2>
  <div class="mx-auto mt-4 flex items-center justify-center gap-2" data-reveal>
    <span class="h-px w-14 bg-terracotta-500/40"></span>
    <FloralImage class="h-10 w-auto opacity-90" />
    <span class="h-px w-14 bg-terracotta-500/40"></span>
  </div>

  <div class="mx-auto mt-14 flex max-w-4xl flex-col gap-14">
    {moments.map((m, i) => (
      <div
        class={`flex flex-col items-center gap-6 sm:gap-10 ${i % 2 === 1 ? "sm:flex-row-reverse" : "sm:flex-row"}`}
      >
        <BotanicalPlate
          plate={m.plate}
          shape="arch"
          class="h-52 w-40 shrink-0 sm:h-60 sm:w-44"
          data-reveal={i % 2 === 1 ? "right" : "left"}
        />

        <div class="flex-1 text-center sm:text-left" data-reveal={i % 2 === 1 ? "left" : "right"}>
          <span class="font-display inline-flex h-9 w-9 items-center justify-center rounded-full bg-terracotta-500 text-cream-50">
            {i + 1}
          </span>
          <h3 class="mt-3 text-lg font-semibold text-dusty-900" data-i18n={`${m.key}.title`}>{t(`${m.key}.title`)}</h3>
          <p class="mt-2 text-sm leading-relaxed text-dusty-700" data-i18n={`${m.key}.text`}>{t(`${m.key}.text`)}</p>
        </div>
      </div>
    ))}
  </div>
</section>
