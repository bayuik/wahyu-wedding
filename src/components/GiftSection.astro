---
import FloralImage from "./FloralImage.astro";
import BotanicalPlate from "./BotanicalPlate.astro";
const accounts = [
  { bank: "BCA", number: "1234567890", holder: "Bayu Indra Kusuma" },
  { bank: "Mandiri", number: "0987654321", holder: "Natasya Widya Rahma" },
];
const ewallets = ["GoPay", "OVO", "DANA"];
---

<section class="bg-botanical relative overflow-hidden bg-dusty-100 px-6 py-16 text-center">
  <FloralImage class="pointer-events-none absolute -top-4 -left-6 h-36 w-auto opacity-85 sm:h-48" />
  <FloralImage class="pointer-events-none absolute -right-6 -bottom-4 h-36 w-auto -scale-x-100 opacity-85 sm:h-48" />

  <h2 class="font-display text-4xl text-dusty-900" data-reveal>Love Gift</h2>
  <div class="mx-auto mt-4 flex items-center justify-center gap-2" data-reveal>
    <span class="h-px w-14 bg-terracotta-500/40"></span>
    <FloralImage class="h-10 w-auto opacity-90" />
    <span class="h-px w-14 bg-terracotta-500/40"></span>
  </div>
  <p class="mx-auto mt-4 max-w-md text-sm text-dusty-700" data-reveal>
    Dengan hormat, bagi Anda yang ingin memberikan tanda kasih kepada kami, dapat melalui:
  </p>

  <BotanicalPlate plate="bloom" shape="arch" class="mx-auto mt-10 h-44 w-32 sm:h-52 sm:w-40" data-reveal="zoom" />

  <div class="mx-auto mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
    {accounts.map((a, i) => (
      <div class="rounded-xl bg-cream-50 p-6 text-left shadow-sm" data-copy-block data-reveal style={`transition-delay: ${i * 120}ms`}>
        <p class="text-xs tracking-widest text-dusty-700 uppercase">{a.bank}</p>
        <p class="font-display mt-2 text-2xl text-dusty-900" data-account-number={a.number}>{a.number}</p>
        <p class="mt-1 text-sm text-dusty-700">a.n. {a.holder}</p>
        <button
          type="button"
          class="copy-btn mt-4 rounded-full border border-terracotta-500 px-4 py-1.5 text-xs uppercase text-terracotta-500 transition hover:bg-terracotta-500 hover:text-cream-50"
          data-copy-value={a.number}
        >
          Salin Nomor
        </button>
      </div>
    ))}
  </div>

  <p class="mt-8 text-sm text-dusty-700">E-wallet: {ewallets.join(" · ")}</p>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const value = btn.dataset.copyValue;
      if (!value) return;
      await navigator.clipboard.writeText(value);
      const original = btn.textContent;
      btn.textContent = "Tersalin!";
      setTimeout(() => (btn.textContent = original), 1500);
    });
  });
</script>
