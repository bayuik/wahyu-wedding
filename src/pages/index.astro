---
import "../styles/global.css";
import Cover from "../components/Cover.astro";
import CoupleInfo from "../components/CoupleInfo.astro";
import EventDetail from "../components/EventDetail.astro";
import GiftSection from "../components/GiftSection.astro";
import Closing from "../components/Closing.astro";
import FloralImage from "../components/FloralImage.astro";
import SectionBlend from "../components/SectionBlend.astro";
import BotanicalPlate from "../components/BotanicalPlate.astro";
import botanicalPattern from "../assets/floral/pattern-botanical.png";
import Countdown from "../components/Countdown.tsx";
import MusicToggle from "../components/MusicToggle.tsx";
import { getGuestNameFromUrl } from "../lib/guest";
import { dict, t, DEFAULT_LANG } from "../lib/i18n";

// personalization needs the query string per-request, so this page is server-rendered
export const prerender = false;

const guestName = getGuestNameFromUrl(Astro.url);

// Absolute URLs: WhatsApp and friends will not resolve a relative og:image.
// PUBLIC_SITE_URL lets production override the origin seen by the request.
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
const ogImage = new URL("/og.jpg", siteUrl).href;
// keep ?to= out of the shared/canonical URL so guest names are not leaked around
const shareUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-i18n="meta.title">{t("meta.title")}</title>

    {/* Share card. Invitations spread through WhatsApp, so a bare link would
        show no preview at all; og.jpg is generated from /og by scripts/make-og.mjs. */}
    <meta name="description" content={t("meta.description")} />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wahyu & Utari" />
    <meta property="og:title" content={t("meta.title")} />
    <meta property="og:description" content={t("meta.description")} />
    <meta property="og:url" content={shareUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wahyu & Utari, 28 October 2026" />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t("meta.title")} />
    <meta name="twitter:description" content={t("meta.description")} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#2e4653" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500&family=Noto+Naskh+Arabic&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="overflow-hidden" style={`--botanical-pattern: url(${botanicalPattern.src})`}>
    <Cover guestName={guestName} />

    <main id="main-content" class="hidden">
      <CoupleInfo />

      <SectionBlend from="from-dusty-900" to="to-dusty-900" height="h-52 sm:h-64" />

      <section class="relative overflow-hidden bg-dusty-900 px-6 py-16">
        <FloralImage class="pointer-events-none absolute -top-3 -left-5 h-32 w-auto opacity-80 sm:h-40" />
        <FloralImage class="pointer-events-none absolute -right-5 -bottom-3 h-32 w-auto -scale-x-100 opacity-80 sm:h-40" />
        <div class="relative z-10">
          <p
            class="text-center text-xs tracking-[0.3em] text-dusty-100 uppercase"
            data-reveal
            data-i18n="countdown.label"
          >
            {t("countdown.label")}
          </p>
          <div class="mt-8">
            <Countdown client:load />
          </div>
        </div>
      </section>

      <EventDetail />

      <Closing />
    </main>

    <MusicToggle client:load />

    <script id="i18n-data" type="application/json" is:inline set:html={JSON.stringify(dict)}></script>

    <script>
      // Language switch. Every translatable node carries data-i18n="<key>"; the
      // dictionary is shipped once as JSON and the swap is a plain text replace,
      // so no re-render or extra request is involved.
      const dataEl = document.getElementById("i18n-data");
      const strings = dataEl ? JSON.parse(dataEl.textContent || "{}") : {};

      function applyLang(lang: string) {
        const table = strings[lang];
        if (!table) return;

        document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
          const key = el.dataset.i18n;
          if (key && table[key] != null) el.textContent = table[key];
        });

        document.documentElement.lang = lang;
        localStorage.setItem("lang", lang);

        document.dispatchEvent(new CustomEvent("lang:change", { detail: { lang } }));
      }

      applyLang("id");
    </script>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );

      document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));

      // parallax drift on decorative layers
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const layers = Array.from(
        document.querySelectorAll<HTMLElement>("[data-parallax]")
      );

      if (!reduceMotion && layers.length > 0) {
        let ticking = false;
        const update = () => {
          const mid = window.innerHeight / 2;
          for (const el of layers) {
            const speed = Number(el.dataset.parallax) || 0.12;
            const rect = el.getBoundingClientRect();
            const offset = (rect.top + rect.height / 2 - mid) * -speed;
            el.style.setProperty("--parallax-y", `${offset.toFixed(1)}px`);
          }
          ticking = false;
        };
        window.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true }
        );
        update();
      }
    </script>
  </body>
</html>
